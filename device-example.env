# Sample local device configuration (signed development builds). Copy to dm/ios/local.env (already
# in .gitignore, not committed) and fill it in; it can also go in ~/.config/dm-ios/local.env to be
# shared by multiple working trees. The one-command IPA build (./make_ipa.sh) does not need this file.

# devicectl device identifier of the real device: the Identifier column of `xcrun devicectl list devices`
DM_DEVICE=

# Hardware UDID of the real device: Xcode → Devices and Simulators → Identifier.
# It must also be filled in when building with a free account (DM_FREE_ACCOUNT=1): the build targets
# this phone, and only then will Apple generate a provisioning profile for a free team (the phone
# must be connected during the build).
DM_IOS_UDID=

# Signing: developer team ID (the Team ID of the team under Xcode → Settings → Accounts) and the
# app bundle ID (your own choice, reverse-domain style, e.g. org.example.mygame).
DM_TEAM_ID=
DM_BUNDLE_ID=

# Set to 1 when using a free developer account (personal team): free profiles expire after 7 days
# (rebuild and reinstall needed), at most 3 devices, at most 3 apps per device. Leave empty for a
# paid account.
DM_FREE_ACCOUNT=1
